# Placeholders for checking the compose files as a second stack beside the one of ci.env, the way a pre-prod stack
# runs beside production on one server (dotnet atom ValidateCompose); nothing here is a real value. Everything that
# would clash between the two stacks differs from ci.env, and PROXY_TRUSTED_CIDR is left out, so the API trusts the
# edge's own address.
PASSEL_TAG=0.0.0-ci
COMPOSE_PROJECT_NAME=passel-preprod
PASSEL_BACKEND_SUBNET=172.30.3.0/24
PASSEL_BACKEND_GATEWAY=172.30.3.1
PASSEL_EDGE_SUBNET=172.30.2.0/24
PASSEL_EDGE_GATEWAY=172.30.2.1
PASSEL_EDGE_IP_RANGE=172.30.2.128/25
PASSEL_EDGE_ADDRESS=172.30.2.2
PASSEL_API_ALIAS=passel-preprod-api
PASSEL_WEB_ALIAS=passel-preprod-web
PASSEL_DEPLOYMENT_ENVIRONMENT=preprod
API_PORT=18082
WEB_PORT=18083
DASHBOARD_PORT=18890
POSTGRES_PASSWORD=3333333333333333333333333333333333333333333333333333333333333333
PASSEL_OWNER_DB_PASSWORD=4444444444444444444444444444444444444444444444444444444444444444
PASSEL_API_DB_PASSWORD=5555555555555555555555555555555555555555555555555555555555555555
ENCODING_ALPHABET='zyxwvutsrqponmlkjihgfedcbaZYXWVUTSRQPONMLKJIHGFEDCBA9876543210'
GOOGLE_WEB_CLIENT_ID=ci-preprod-web.apps.googleusercontent.com
CHROME_EXTENSION_CLIENT_ID=ci-preprod-extension.apps.googleusercontent.com
API_HOST=api.preprod.example.test
WEB_HOST=preprod.example.test
WEB_ORIGIN=https://preprod.example.test
PROXY_NETWORK=proxy
