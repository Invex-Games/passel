# The server's settings for Passel on Docker Compose: copy this file to /opt/passel/.env, fill it in and keep it
# readable by the deploy user only (chmod 600). deploy.sh reads it on every deploy; release.env, which deploy.sh
# writes, adds PASSEL_TAG. See docs/guides/deploying.md.

# --- Which files and services compose uses ------------------------------------------------------------------------
# Set here so that every docker compose command, deploy.sh's and yours, sees the same project. Paths are relative to
# a release directory. Pick one way of reaching the API and the web app:
#   bundled Caddy edge with Let's Encrypt:  COMPOSE_FILE=compose.yaml          COMPOSE_PROFILES=edge
#   a proxy in its own Docker network:      COMPOSE_FILE=compose.yaml:compose.external-proxy.yaml
#   a proxy running on the host:            COMPOSE_FILE=compose.yaml:compose.ports.yaml
# Add telemetry to COMPOSE_PROFILES (comma-separated) for the local Aspire dashboard.
COMPOSE_FILE=compose.yaml
COMPOSE_PROFILES=edge
# COMPOSE_PROJECT_NAME=passel

# --- Secrets ------------------------------------------------------------------------------------------------------
# Generate each password with: openssl rand -hex 32
# Hex needs no quoting in a connection string or here. Changing one and deploying changes that login's password.
POSTGRES_PASSWORD=
PASSEL_OWNER_DB_PASSWORD=
PASSEL_API_DB_PASSWORD=
# The Sqids alphabet that every public id is encoded with: at least 10 distinct characters, single-quoted, and never
# changed once the API has handed out an id. If an earlier deployment (Azure) held data, use its ENCODING_ALPHABET.
# Generate one with: echo abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 | fold -w1 | shuf | paste -sd "" -
ENCODING_ALPHABET=''

# --- Database -----------------------------------------------------------------------------------------------------
# The superuser and the database it creates on first start. passel_owner and passel_api are made by db-roles.
POSTGRES_USER=postgres
POSTGRES_DB=passel

# --- Identity -----------------------------------------------------------------------------------------------------
# The Google OAuth client ids whose ID tokens the API accepts: the web client (also the mobile app's server client)
# and the Chrome extension's.
GOOGLE_WEB_CLIENT_ID=
CHROME_EXTENSION_CLIENT_ID=

# --- Domains ------------------------------------------------------------------------------------------------------
# API_HOST is the API's host name, which the API also accepts as Host; WEB_HOST is the web app's. WEB_ORIGIN is the
# web app's origin exactly as a browser sends it: scheme and host, no path and no trailing slash.
API_HOST=api.passel.link
WEB_HOST=passel.link
WEB_ORIGIN=https://passel.link

# --- Proxy --------------------------------------------------------------------------------------------------------
# The only address whose X-Forwarded-For and X-Forwarded-Proto the API believes. The default is the bundled edge's
# fixed address. Behind an external proxy network use that proxy's address as a /32 (or the network's CIDR); behind a
# proxy on the host use the edge network's gateway, 172.30.0.1/32.
PROXY_TRUSTED_CIDR=172.30.0.2/32
# The existing Docker network of an external proxy (compose.external-proxy.yaml only).
# PROXY_NETWORK=proxy

# --- Ports (compose.ports.yaml only) ------------------------------------------------------------------------------
# Bound to 127.0.0.1 on the server.
# API_PORT=18080
# WEB_PORT=18081

# --- Checks and telemetry -----------------------------------------------------------------------------------------
# What deploy.sh fetches after starting the release; https://API_HOST/health when unset.
# SMOKE_URL=https://api.passel.link/health
# Where the API sends its logs, traces and metrics over OTLP; nothing is exported when unset. With the telemetry
# profile: http://dashboard:18889
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_HEADERS=

# --- Registry (deploy-gate.sh) ------------------------------------------------------------------------------------
# deploy-gate.sh reads these from its own environment, not from this file; the defaults are GHCR and invex-games.
# PASSEL_REGISTRY=ghcr.io
# PASSEL_IMAGE_NAMESPACE=invex-games
