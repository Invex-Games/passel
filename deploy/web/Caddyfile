# The web app on plain HTTP; the hosting rules are in docs/components/web-app.md.
{
	# No admin API, no certificates and no saved config: the container only serves files
	admin off
	auto_https off
	persist_config off
}

# Sent with every response, the 404 page included
(security_headers) {
	header {
		# File names carry no content hash, so browsers revalidate every file (ETag and Last-Modified give a 304)
		Cache-Control "no-cache"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The pages carry their own policies in a meta tag, which cannot set frame-ancestors
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

:8080 {
	import security_headers

	root * /srv
	encode zstd gzip

	# A static site takes no uploads
	request_body {
		max_size 1MB
	}

	# The mobile app links to /privacy and /terms without the slash
	@no_slash path /privacy /terms /app
	redir @no_slash {path}/ 308

	file_server

	handle_errors 404 {
		import security_headers
		rewrite * /404.html
		file_server
	}
}
