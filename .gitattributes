# Line endings: LF in the repository and in every working tree, whatever core.autocrlf says.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files are never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.psd binary
*.keystore binary
*.jks binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
