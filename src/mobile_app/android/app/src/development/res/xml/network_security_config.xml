<?xml version="1.0" encoding="utf-8"?>
<!--
    Development flavor only (this file lives in src/development). Permits plain
    HTTP to the hosts a developer's machine appears as from the device:
    localhost and 127.0.0.1 through `adb reverse`, 10.0.2.2 from an emulator.
    Every other host keeps the platform default: cleartext blocked, system
    certificates only. Keep the list in step with AppConfig.cleartextHosts in
    lib/config/app_config.dart, which rejects an http:// API_BASE_URL to any
    other host before the request fails less obviously.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
