# Local development configuration for the Passel mobile app.
#
# Copy this file to `.env` (git-ignored) and fill in the values, then use the
# "Mobile app (development)" VS Code launch configuration, or run:
#   flutter run --flavor development --dart-define-from-file=.env
#
# The values are compiled in as dart-defines (see lib/config/app_config.dart);
# nothing is bundled as an asset, so builds without a .env (e.g. CI, which
# passes --dart-define=KEY=value instead) work fine.

# The API root as the device can reach it, with the AppHost running:
# - A phone on USB (the default): run `adb reverse tcp:5218 tcp:5218` after plugging it
#   in, and the phone reaches the API at http://localhost:5218.
# - An Android emulator: http://10.0.2.2:5218.
# - A phone that is not on USB: start the passel-api-tunnel resource in the Aspire
#   dashboard and use its URL. While it runs, anyone with that URL can reach your
#   Development API; see docs/getting-started/running-locally.md.
# Plain http:// is only accepted for localhost, 127.0.0.1 and 10.0.2.2, and only by the
# development flavor; the production flavor requires https://.
API_BASE_URL=http://localhost:5218

# Only with a tunnel that doesn't allow anonymous access (DevTunnel:AllowAnonymous set
# to false in the AppHost): the access token from `devtunnel token <tunnel-id> --scopes
# connect`, sent as X-Tunnel-Authorization with every request. Development flavor only.
# TUNNEL_ACCESS_TOKEN=

# SERVER_CLIENT_ID is the Google OAuth web client id (the AppHost's google-client-id
# parameter). APP_CLIENT_ID is the Android OAuth client id.
SERVER_CLIENT_ID=your-server-client-id.apps.googleusercontent.com
APP_CLIENT_ID=your-app-client-id.apps.googleusercontent.com
