{
  "manifest_version": 3,
  "name": "Passel",
  "key": "",
  "description": "Send links and notes between your devices.",
  "homepage_url": "https://passel.link",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "activeTab",
    "identity",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "MacCtrl+Shift+P"
      }
    },
    "send-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S",
        "chromeos": "Alt+Shift+Y"
      },
      "description": "Send this page, or the selected text, to your devices"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "MacCtrl+Shift+O"
      },
      "description": "Open Passel in the side panel"
    }
  },
  "omnibox": {
    "keyword": "passel"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}