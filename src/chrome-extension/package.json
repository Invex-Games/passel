{
  "name": "passel-chrome-extension",
  "version": "1.0.0",
  "homepage": "https://passel.link",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node build.mjs --dev",
    "dev:watch": "node build.mjs --dev --watch",
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "harness": "node harness/serve.mjs",
    "clean": "node -e \"for (const dir of ['dist', 'out']) require('fs').rmSync(dir, {recursive: true, force: true})\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@passel/core": "*",
    "@passel/ui": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0"
  }
}
