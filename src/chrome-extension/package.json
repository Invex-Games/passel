{
  "name": "passel-chrome-extension",
  "version": "1.0.0",
  "homepage": "https://passel.link",
  "private": true,
  "scripts": {
    "dev": "node build.mjs --dev",
    "dev:watch": "node build.mjs --dev --watch",
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "powershell -Command \"Remove-Item dist,out -Recurse -Force -ErrorAction SilentlyContinue; exit 0\"",
    "package": "npm run clean && npm run build && powershell -Command \"New-Item -ItemType Directory -Path out -Force | Out-Null; Compress-Archive -Path dist/* -DestinationPath out/passel.zip -Force\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3"
  }
}
