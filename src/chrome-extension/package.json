{
  "name": "passel-chrome-extension",
  "version": "1.0.0",
  "homepage": "https://passel.link",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node build.mjs --dev",
    "dev:watch": "node build.mjs --dev --watch",
    "build": "tsc --noEmit && vitest run && node build.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for (const dir of ['dist', 'out']) require('fs').rmSync(dir, {recursive: true, force: true})\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
