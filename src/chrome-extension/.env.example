# Local configuration for building the Passel Chrome extension outside the AppHost.
#
# Not needed when the Aspire AppHost runs the extension's watch build: it passes both values
# itself, and they take precedence over this file. For a standalone build, copy this file to
# `.env` (git-ignored), fill it in, and run `npm run dev` or `npm run dev:watch`.

# The packets endpoint (not the API root); the extension appends /events and /{id} to it.
API_URL=https://localhost:7030/api/packets

# The extension's Google OAuth client id. The API must accept it as an audience
# (Authentication:Google:AdditionalAudiences). May be left empty with DEV_SIGN_IN=true.
GOOGLE_CLIENT_ID=your-extension-client-id.apps.googleusercontent.com

# Development builds only (`npm run dev`, `npm run dev:watch`): set to true and the popup also
# offers signing in as a development user, through the API's Dev scheme (Authorization: Dev <user>),
# which the API accepts only while it runs in Development. Different names are different accounts.
# The AppHost sets it. `npm run build` never compiles it in.
# DEV_SIGN_IN=true
