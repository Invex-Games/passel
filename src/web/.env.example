# Local configuration for the Passel web app's dev server outside the AppHost.
#
# Not needed when the Aspire AppHost runs the web app's dev server: it passes these values itself,
# and they take precedence over this file. For a standalone dev server, copy this file to `.env`
# (git-ignored), fill it in, and run `npm run dev` or `npm run serve`. A production build
# (`npm run build`) reads none of it: the site holds no environment's values, and the web image
# provides them when its container starts (docs/components/web-app.md).

# The packets endpoint (not the API root); the app appends /events to it. The dev server serves it
# in /app/config.json and allows its origin in the app's Content-Security-Policy. The API must list
# the web app's origin in Cors:AllowedOrigins (the AppHost does this for http://localhost:5245).
API_URL=https://localhost:7030/api/packets

# The Google OAuth **web** client id: the API's main audience, served in /app/config.json. Its
# Authorized JavaScript origins must include the web app's origin (http://localhost and
# http://localhost:5245 for local work). May be left empty with DEV_SIGN_IN=true.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Development builds only (`npm run dev`): set to true and the sign-in page also offers signing in
# as a development user, through the API's Dev scheme (Authorization: Dev <user>), which the API
# accepts only while it runs in Development. The AppHost sets it. `npm run build` never compiles it in.
# DEV_SIGN_IN=true

# The port of the dev server (`npm run dev`, `npm run serve`). The AppHost sets it.
# PORT=5245
