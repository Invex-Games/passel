{
  "name": "passel-web",
  "private": true,
  "description": "The npm workspace of Passel's TypeScript code: the shared core and UI packages, the Chrome extension and the web app.",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "chrome-extension",
    "web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "build": "npm run build --workspace chrome-extension --workspace web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
