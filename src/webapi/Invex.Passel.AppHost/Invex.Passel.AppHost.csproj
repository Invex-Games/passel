<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="13.3.1"/>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
        <UserSecretsId>8df5bd35-6d45-4216-9d6d-e2823216a62a</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.2" />
        <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Invex.Passel.WebApi\Invex.Passel.WebApi.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="appsettings.Development.json">
        <DependentUpon>appsettings.json</DependentUpon>
      </None>
    </ItemGroup>

</Project>
