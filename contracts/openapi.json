                  "value": {
                    "name": "Packet name",
                    "url": "https://example.com"
                  }
                },
                "Text": {
                  "value": {
                    "title": "Packet title",
                    "body": "Packet body"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
