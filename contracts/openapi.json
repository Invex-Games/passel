  "components": {
    "schemas": {
      "DevicePlatform": {
        "enum": [
          "android",
          "extension",
          "web"
        ],
        "description": "The kinds of client that register as devices. A device's platform is set when it registers and decides the\nkind of push token it may hold: an `Fcm` token on Android, a `WebPush` subscription in the extension\nand the web app."
      },
      "DeviceResponse": {
        "required": [
          "id",
          "name",
          "platform",
          "createdAt",
          "lastSeenAt",
          "pushUpdatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The device's public id, opaque to clients. A client keeps the id its registration returned to tell\nitself apart in the list."
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "$ref": "#/components/schemas/DevicePlatform"
          },
          "createdAt": {
            "type": "string",
            "description": "When the installation first registered, in UTC.",
            "format": "date-time"
          },
          "lastSeenAt": {
            "type": "string",
            "description": "When the installation last registered, in UTC.",
            "format": "date-time"
          },
          "pushUpdatedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "When the device's push token was last set, in UTC, or `null` when it has none.",
            "format": "date-time"
          }
        },
        "description": "A device as the API returns it: the shape of a `GET /api/devices` item and of the registration and\nrename responses."
      },
      "GetDevicesResponseBody": {
        "required": [
          "devices"
        ],
        "type": "object",
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeviceResponse"
            }
          }
        },
        "description": "All of the caller's devices, in the order they registered. Not paged: the device cap bounds the list."
      },
      "GetPacketsResponseBody": {
        "required": [
          "packets"
        ],
        "type": "object",
        "properties": {
          "packets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PacketResponse"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ],
            "description": "The cursor for the next page, or `null` on the last one."
          }
        },
        "description": "One page of the caller's packets, newest first."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "LinkPreviewResponse": {
        "required": [
          "title",
          "description",
          "imageUrl",
          "fetchedAt"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "An absolute http or https URL, as the page gave it. The API has not fetched or checked it; clients\nload it like any third-party image."
          },
          "fetchedAt": {
            "type": "string",
            "description": "When the page was read, in UTC.",
            "format": "date-time"
          }
        },
        "description": "What a link's page said about itself, as the API returns it on a link packet. Each of the three fields\nmay be `null`, but never all three: a preview with nothing to show is not stored."
      },
      "PacketResponse": {
        "required": [
          "$type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/PacketResponseLink"
          },
          {
            "$ref": "#/components/schemas/PacketResponseText"
          },
          {
            "$ref": "#/components/schemas/PacketResponseFile"
          }
        ],
        "description": "A packet as the API returns it: the shape of a `GET /api/packets` item, of the\n`POST /api/packets` response and of the `packet-created` and `packet-updated` event data.",
        "discriminator": {
          "propertyName": "$type",
          "mapping": {
            "Link": "#/components/schemas/PacketResponseLink",
            "Text": "#/components/schemas/PacketResponseText",
            "File": "#/components/schemas/PacketResponseFile"
          }
        }
      },
      "PacketResponseFile": {
        "required": [
          "id",
          "createdAt",
          "fileName",
          "contentType",
          "parcelId",
          "isImage"
        ],
        "properties": {
          "$type": {
            "enum": [
              "File"
            ],
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "The packet's public id, opaque to clients; the list pages on it."
          },
          "createdAt": {
            "type": "string",
            "description": "When the packet was created, in UTC.",
            "format": "date-time"
          },
          "fileName": {
            "type": [
              "null",
              "string"
            ]
          },
          "contentType": {
            "type": "string"
          },
          "parcelId": {
            "type": "string"
          },
          "isImage": {
            "type": "boolean"
          }
        }
      },
      "PacketResponseLink": {
        "required": [
          "id",
          "createdAt",
          "name",
          "url",
          "preview"
        ],
        "properties": {
          "$type": {
            "enum": [
              "Link"
            ],
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "The packet's public id, opaque to clients; the list pages on it."
          },
          "createdAt": {
            "type": "string",
            "description": "When the packet was created, in UTC.",
            "format": "date-time"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "url": {
            "type": "string"
          },
          "preview": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LinkPreviewResponse"
              }
            ],
            "description": "The page's title, description and image, once the API has fetched them: `null` on the create\nresponse and the `packet-created` event, set on the `packet-updated` event and the list\nfrom then on, and `null` for good when the page gave nothing or could not be fetched."
          }
        }
      },
      "PacketResponseText": {
        "required": [
          "id",
          "createdAt",
          "title",
          "body"
        ],
        "properties": {
          "$type": {
            "enum": [
              "Text"
            ],
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "The packet's public id, opaque to clients; the list pages on it."
          },
          "createdAt": {
            "type": "string",
            "description": "When the packet was created, in UTC.",
            "format": "date-time"
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "body": {
            "type": "string"
          }
        }
      },
      "PostPacketRequestBody": {
        "required": [
          "$type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/PostPacketRequestBodyLink"
          },
          {
            "$ref": "#/components/schemas/PostPacketRequestBodyText"
          },
          {
            "$ref": "#/components/schemas/PostPacketRequestBodyFile"
          }
        ],
        "discriminator": {
          "propertyName": "$type",
          "mapping": {
            "Link": "#/components/schemas/PostPacketRequestBodyLink",
            "Text": "#/components/schemas/PostPacketRequestBodyText",
            "File": "#/components/schemas/PostPacketRequestBodyFile"
          }
        }
      },
      "PostPacketRequestBodyFile": {
        "required": [
          "fileName",
          "contentType",
          "payload"
        ],
        "properties": {
          "$type": {
            "enum": [
              "File"
            ],
            "type": "string"
          },
          "fileName": {
            "type": [
              "null",
              "string"
            ]
          },
          "contentType": {
            "type": "string"
          },
          "payload": {}
        }
      },
      "PostPacketRequestBodyLink": {
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "$type": {
            "enum": [
              "Link"
            ],
            "type": "string"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      },
      "PostPacketRequestBodyText": {
        "required": [
          "title",
          "body"
        ],
        "properties": {
          "$type": {
            "enum": [
              "Text"
            ],
            "type": "string"
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "body": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
