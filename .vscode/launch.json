{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mobile app (development)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/mobile_app",
      "program": "${workspaceFolder}/src/mobile_app/lib/main.dart",
      "toolArgs": [
        "--flavor",
        "development",
        "--dart-define-from-file=${workspaceFolder}/src/mobile_app/.env"
      ]
    }
  ]
}