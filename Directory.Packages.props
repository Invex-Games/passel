<Project>

  <!-- Every PackageReference in the solution takes its version from here (central package management). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Web API">
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageVersion Include="Aspire.Azure.Npgsql" Version="13.6.4" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.6.4" />
    <PackageVersion Include="Dunet" Version="1.16.2" />
    <PackageVersion Include="Google.Apis.Auth.AspNetCore3" Version="1.78.0" />
    <PackageVersion Include="Marten" Version="9.58.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
    <PackageVersion Include="SkiaSharp" Version="4.155.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.155.0" />
    <PackageVersion Include="Sqids" Version="3.2.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.KeyVault" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.DevTunnels" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.4" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
    <PackageVersion Include="Azure.ResourceManager.AppContainers" Version="1.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup Label="Shared">
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup Label="Build (Atom)">
    <PackageVersion Include="Invex.Atom.Build" Version="5.0.0" />
    <PackageVersion Include="Invex.Atom.Module.AzureKeyVault" Version="5.0.0" />
    <PackageVersion Include="Invex.Atom.Module.GithubWorkflows" Version="5.0.0" />
    <PackageVersion Include="Invex.Atom.Module.GitVersion" Version="5.0.0" />
    <PackageVersion Include="Invex.RepoUtils.Atom.Module" Version="3.0.0" />
  </ItemGroup>

</Project>
